# Todo valor de config/config.json pode ser sobrescrito por variavel de ambiente.
# Regra: IPTV_ + caminho da chave em maiuscula, separado por _ (sem camelCase).
#   config.validation.concurrency        -> IPTV_VALIDATION_CONCURRENCY
#   config.validation.recheckHours.WORKING -> IPTV_VALIDATION_RECHECKHOURS_WORKING
# Nenhum numero de limite, timeout ou concorrencia vive no codigo.

# --- Identidade do repositorio (entra no url-tvg e nas URLs Raw do README) ---
IPTV_REPO_OWNER=melocalex
IPTV_REPO_NAME=iptv-br-playlist
IPTV_REPO_BRANCH=main

# --- Ponto de observacao da validacao ---
# Resultado de validacao depende de onde o teste roda. Runner do GitHub fica nos EUA e
# ve disponibilidade diferente de quem esta no Brasil. O relatorio separa por vantage.
# Valores usados no projeto: local-br (sua maquina) | github-us (Actions).
IPTV_VANTAGE=local-br

# --- HTTP (download de fontes) ---
IPTV_HTTP_CONNECTTIMEOUTMS=8000
IPTV_HTTP_READTIMEOUTMS=30000
IPTV_HTTP_RETRIES=2
IPTV_HTTP_RETRYBACKOFFMS=1500

# --- Validacao de stream ---
IPTV_VALIDATION_CONCURRENCY=10
IPTV_VALIDATION_CONNECTTIMEOUTMS=8000
IPTV_VALIDATION_PROBETIMEOUTMS=15000
IPTV_VALIDATION_ATTEMPTSPERSTREAM=2
# Quantos streams checar por execucao. Protege o workflow de estourar o tempo.
IPTV_VALIDATION_MAXCHECKSPERRUN=1200
# Falhas consecutivas antes de sair das playlists validadas. Nunca remove de playlist-all.m3u.
IPTV_VALIDATION_DROPAFTERFAILURES=3
IPTV_VALIDATION_FFPROBEPATH=ffprobe
# Horas de carencia antes de rechecar, por status (validacao incremental).
IPTV_VALIDATION_RECHECKHOURS_WORKING=24
IPTV_VALIDATION_RECHECKHOURS_UNSTABLE=12
IPTV_VALIDATION_RECHECKHOURS_OFFLINE=72
IPTV_VALIDATION_RECHECKHOURS_TIMEOUT=48
IPTV_VALIDATION_RECHECKHOURS_GEO_BLOCKED=168
IPTV_VALIDATION_RECHECKHOURS_AUTH_REQUIRED=168
IPTV_VALIDATION_RECHECKHOURS_UNSUPPORTED=168

# --- EPG ---
IPTV_EPG_ENABLED=true
IPTV_EPG_DAYS=2
IPTV_EPG_MAXCONNECTIONS=5
IPTV_EPG_REQUESTTIMEOUTMS=30000
IPTV_EPG_GRABTIMEOUTMS=1800000
IPTV_EPG_MAXCHANNELSPERSITE=400
IPTV_EPG_PROGRAMMEHORIZONHOURS=72

# --- Filtros ---
IPTV_FILTERS_EXCLUDENSFW=true
IPTV_FILTERS_EXCLUDECLOSEDCHANNELS=true
