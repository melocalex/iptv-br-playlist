# Every value in config/config.json can be overridden by an environment variable.
# Rule: IPTV_ + the key path in upper case, separated by _ (no camelCase).
#   config.validation.concurrency          -> IPTV_VALIDATION_CONCURRENCY
#   config.validation.recheckHours.WORKING -> IPTV_VALIDATION_RECHECKHOURS_WORKING
# No limit, timeout or concurrency number lives in the code.

# --- Repository identity (goes into url-tvg and the raw URLs in the README) ---
IPTV_REPO_OWNER=melocalex
IPTV_REPO_NAME=lighteye
IPTV_REPO_BRANCH=main

# --- Observation point for validation ---
# A validation result depends on where the probe runs. The GitHub runner sits in the US
# and sees different availability than a machine in Brazil. The report keeps them apart.
# Values used in this project: local-br (your machine) | github-us (Actions).
IPTV_VANTAGE=local-br

# --- HTTP (source downloads) ---
IPTV_HTTP_CONNECTTIMEOUTMS=8000
IPTV_HTTP_READTIMEOUTMS=30000
IPTV_HTTP_RETRIES=2
IPTV_HTTP_RETRYBACKOFFMS=1500

# --- Stream validation ---
IPTV_VALIDATION_CONCURRENCY=10
IPTV_VALIDATION_CONNECTTIMEOUTMS=8000
IPTV_VALIDATION_PROBETIMEOUTMS=15000
IPTV_VALIDATION_ATTEMPTSPERSTREAM=2
# How many streams to check per run. Keeps the workflow inside its time budget.
IPTV_VALIDATION_MAXCHECKSPERRUN=1200
# Consecutive failures before a stream leaves the validated playlists.
# It is never removed from playlist-all.m3u.
IPTV_VALIDATION_DROPAFTERFAILURES=3
IPTV_VALIDATION_FFPROBEPATH=ffprobe
# Grace period in hours before re-checking, per status (incremental validation).
IPTV_VALIDATION_RECHECKHOURS_WORKING=24
IPTV_VALIDATION_RECHECKHOURS_UNSTABLE=12
IPTV_VALIDATION_RECHECKHOURS_OFFLINE=72
IPTV_VALIDATION_RECHECKHOURS_TIMEOUT=48
IPTV_VALIDATION_RECHECKHOURS_GEO_BLOCKED=168
IPTV_VALIDATION_RECHECKHOURS_AUTH_REQUIRED=168
IPTV_VALIDATION_RECHECKHOURS_UNSUPPORTED=168

# --- Programme guide ---
IPTV_EPG_ENABLED=true
IPTV_EPG_DAYS=2
IPTV_EPG_MAXCONNECTIONS=5
IPTV_EPG_REQUESTTIMEOUTMS=30000
IPTV_EPG_GRABTIMEOUTMS=1800000
IPTV_EPG_MAXCHANNELSPERSITE=400
IPTV_EPG_PROGRAMMEHORIZONHOURS=72
# Per-channel guide slices: short window, description cap, file ceiling.
IPTV_EPG_SLICEHORIZONHOURS=24
IPTV_EPG_SLICEDESCMAXCHARS=300
IPTV_EPG_MAXSLICEFILES=2000

# --- Filters ---
IPTV_FILTERS_EXCLUDENSFW=true
IPTV_FILTERS_EXCLUDECLOSEDCHANNELS=true

# =============================================================================
# Retrieval layer (config/rag.json). Same rule, with its own prefix:
#   rag.retrieval.topK                    -> IPTV_RAG_RETRIEVAL_TOPK
#   rag.freshness.staleAfterHours.WORKING -> IPTV_RAG_FRESHNESS_STALEAFTERHOURS_WORKING
# =============================================================================

# --- Generation credential ---
# The only variable WITHOUT the IPTV_ prefix, because it is a credential, not a limit.
# Without it retrieval still works and the answer falls back to the deterministic
# wording, with a notice. Never commit this key; .env is in .gitignore.
# ANTHROPIC_API_KEY=

# --- Corpus read by retrieval ---
IPTV_RAG_CORPUS_CHANNELSFILE=data/channels.json
IPTV_RAG_CORPUS_EPGSLICEDIR=docs/epg
# false lets in channels that never worked from any point; the default keeps only
# what has been confirmed from at least one observation point.
IPTV_RAG_CORPUS_REQUIREELIGIBLE=true
IPTV_RAG_CORPUS_REQUIRECLASSIFIED=true

# --- Lexical retrieval (hand-written BM25, no vector database) ---
IPTV_RAG_RETRIEVAL_BM25K1=1.2
IPTV_RAG_RETRIEVAL_BM25B=0.75
IPTV_RAG_RETRIEVAL_MINTOKENLENGTH=2
IPTV_RAG_RETRIEVAL_PROGRAMMETOPK=12
IPTV_RAG_RETRIEVAL_DEFAULTLIMIT=8
IPTV_RAG_RETRIEVAL_MAXLIMIT=50
# Ranking bonuses: confirmed from your point, has a guide, on air, measured PT audio.
IPTV_RAG_RETRIEVAL_VANTAGEBONUS=1.5
IPTV_RAG_RETRIEVAL_GUIDEBONUS=1
IPTV_RAG_RETRIEVAL_ONAIRBONUS=2
IPTV_RAG_RETRIEVAL_VERIFIEDAUDIOBONUS=1

# --- Evidence freshness (hours) ---
# Past the deadline a channel drops out of recommendations and the system abstains.
IPTV_RAG_FRESHNESS_STALEAFTERHOURS_WORKING=48
IPTV_RAG_FRESHNESS_STALEAFTERHOURS_UNSTABLE=24
IPTV_RAG_FRESHNESS_STALEAFTERHOURS_OFFLINE=168
IPTV_RAG_FRESHNESS_STALEAFTERHOURS_TIMEOUT=168
IPTV_RAG_FRESHNESS_STALEAFTERHOURS_GEO_BLOCKED=336
IPTV_RAG_FRESHNESS_STALEAFTERHOURS_AUTH_REQUIRED=336
IPTV_RAG_FRESHNESS_STALEAFTERHOURS_UNSUPPORTED=336
IPTV_RAG_FRESHNESS_PROGRAMMETOLERANCESECONDS=300
IPTV_RAG_FRESHNESS_GUIDESTALEAFTERHOURS=36

# --- Size of the evidence block sent in the prompt ---
IPTV_RAG_ANSWER_MAXCANDIDATES=8
IPTV_RAG_ANSWER_MAXOBSERVATIONSPERCHANNEL=4
IPTV_RAG_ANSWER_MAXNEXTPROGRAMMES=2
IPTV_RAG_ANSWER_MAXDESCCHARS=240
# Cap on channel names and programme titles, which come from a third-party source
# and enter the model context as data.
IPTV_RAG_ANSWER_MAXTEXTCHARS=120

# --- Generation ---
IPTV_RAG_GENERATION_ENABLED=true
IPTV_RAG_GENERATION_BASEURL=https://api.anthropic.com
IPTV_RAG_GENERATION_APIVERSION=2023-06-01
IPTV_RAG_GENERATION_MODEL=claude-sonnet-5-5
IPTV_RAG_GENERATION_MAXTOKENS=1500
IPTV_RAG_GENERATION_TEMPERATURE=0
IPTV_RAG_GENERATION_TIMEOUTMS=60000
IPTV_RAG_GENERATION_RETRIES=2
IPTV_RAG_GENERATION_RETRYBACKOFFMS=1500
